<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>FileFlow</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationIcon>Assets/fileflow.ico</ApplicationIcon>
    <Description>Preview-first file organization for Windows</Description>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../FileFlow.Core/FileFlow.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/fileflow.ico" LogicalName="FileFlow.fileflow.ico" /></ItemGroup>
</Project>
